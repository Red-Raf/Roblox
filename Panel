VisualTab.CreateToggle({ ru = "Подсветка игроков (ESP)", en = "ESP" }, false, function(state)
    if state then
        local function addESP(p)
            if p == LocalPlayer then return end
            local function onChar(c)
                if not c:FindFirstChild("IY_ESP") then
                    local hl = Instance.new("Highlight")
                    hl.Name = "IY_ESP"
                    hl.Adornee = c
                    hl.FillColor = espColors[currentEspColorIndex].color
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.Parent = c
                end
            end
            if p.Character then onChar(p.Character) end
            p.CharacterAdded:Connect(onChar)
        end
        for _, p in ipairs(Players:GetPlayers()) do
            addESP(p)
        end
        espConn = Players.PlayerAdded:Connect(addESP)
    else
        if espConn then espConn:Disconnect() end
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character and p.Character:FindFirstChild("IY_ESP") then
                p.Character.IY_ESP:Destroy()
            end
        end
    end
end)

VisualTab.CreateButton({ ru = "Сменить цвет ESP", en = "Change ESP Color" }, function()
    currentEspColorIndex = currentEspColorIndex % #espColors + 1
    local colData = espColors[currentEspColorIndex]
    Window:Notify({ ru = "Цвет ESP: " .. colData.name, en = "ESP Color: " .. colData.name }, 2)
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character and p.Character:FindFirstChild("IY_ESP") then
            p.Character.IY_ESP.FillColor = colData.color
        end
    end
end)

VisualTab.CreateToggle({ ru = "Невидимость (Invisible)", en = "Invisible" }, false, function(state)
    local char = LocalPlayer.Character
    if char then
        local targetTransparency = state and 1 or 0
        for _, v in ipairs(char:GetDescendants()) do
            if v:IsA("BasePart") or v:IsA("Decal") then
                v.LocalTransparencyModifier = targetTransparency
            end
        end
    end
end)

VisualTab.CreateToggle({ ru = "Полное освещение (Fullbright)", en = "Fullbright" }, false, function(state)
    if state then
        Lighting.Ambient = Color3.new(1, 1, 1)
        Lighting.OutdoorAmbient = Color3.new(1, 1, 1)
        Lighting.Brightness = 3
    else
        Lighting.Ambient = Color3.new(0, 0, 0)
        Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
        Lighting.Brightness = 2
    end
end)

