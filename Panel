local DecodeTab = Window:CreateTab("Декодировка", 4483362458)

DecodeTab:CreateParagraph({
	Title = "Режим декодировки скриптов",
	Content = "Считывает запущенные скрипты и модули в игре, декомпилирует их и выводит логику вместе с функциями в консоль (F9)."
})

local decodeFilterText = ""
DecodeTab:CreateInput({
	Name = "Фильтр по имени скрипта (необязательно)",
	PlaceholderText = "Введите часть имени...",
	RemoveTextAfterFocusLost = false,
	Callback = function(text)
		decodeFilterText = text
	end,
})

DecodeTab:CreateButton({
	Name = "Сканировать и декодировать скрипты",
	Callback = function()
		if not decompile then
			Rayfield:Notify({
				Title = "Ошибка",
				Content = "Ваш экзекьютор не поддерживает функцию decompile()!",
				Duration = 4,
				Image = 4483362458
			})
			return
		end

		local success, result = pcall(function()
			local modules = {}
			if getloadedmodules then
				modules = getloadedmodules()
			else
				for _, v in ipairs(game:GetDescendants()) do
					if v:IsA("LocalScript") or v:IsA("ModuleScript") then
						table.insert(modules, v)
					end
				end
			end

			local count = 0
			print("==================== НАЧАЛО ДЕКОДИРОВКИ ====================")
			for _, scr in ipairs(modules) do
				local name = scr.Name
				if decodeFilterText == "" or string.find(string.lower(name), string.lower(decodeFilterText)) then
					local status, sourceCode = pcall(function()
						return decompile(scr)
					end)
					if status and sourceCode then
						count = count + 1
						print("\n--- Скрипт [" .. count .."]: " .. scr:GetFullName() .. " ---")
						print(sourceCode)
					end
				end
			end
			print("==================== КОНЕЦ ДЕКОДИРОВКИ (Найдено: " .. count .. ") ====================")
			return count
		end)

		if success then
			Rayfield:Notify({
				Title = "Декодировка завершена",
				Content = "Успешно обработано скриптов. Откройте консоль (F9) для просмотра кода.",
				Duration = 5,
				Image = 4483362458
			})
		else
			Rayfield:Notify({
				Title = "Ошибка",
				Content = "Произошла ошибка при сканировании скриптов.",
				Duration = 3,
				Image = 4483362458
			})
		end
	end,
})

