local VisualsTab = Window:CreateTab("Визуалы", "rbxassetid://6031080277")

local espColors = {
	{name = "Red", color = Color3.fromRGB(255, 0, 0)},
	{name = "Green", color = Color3.fromRGB(0, 255, 0)},
	{name = "Blue", color = Color3.fromRGB(0, 150, 255)},
	{name = "Yellow", color = Color3.fromRGB(255, 255, 0)},
	{name = "Purple", color = Color3.fromRGB(150, 0, 255)},
	{name = "White", color = Color3.fromRGB(255, 255, 255)}
}
local currentEspColorIndex = 1
local espConn = nil

VisualsTab:CreateToggle({
	Name = "ESP Подсветка игроков (Player ESP)",
	CurrentValue = false,
	Flag = "ESPToggle",
	Callback = function(state)
		if state then
			local function addESP(p)
				if p == LocalPlayer then return end
				local function onChar(c)
					if not c:FindFirstChild("IY_ESP") then
						local hl = Instance.new("Highlight")
						hl.Name = "IY_ESP"
						hl.Adornee = c
						hl.FillColor = espColors[currentEspColorIndex].color
						hl.OutlineColor = Color3.fromRGB(255, 255, 255)
						hl.Parent = c
					end
				end
				if p.Character then onChar(p.Character) end
				p.CharacterAdded:Connect(onChar)
			end
			for _, p in ipairs(Players:GetPlayers()) do
				addESP(p)
			end
			espConn = Players.PlayerAdded:Connect(addESP)
		else
			if espConn then espConn:Disconnect() end
			for _, p in ipairs(Players:GetPlayers()) do
				if p.Character and p.Character:FindFirstChild("IY_ESP") then
					p.Character.IY_ESP:Destroy()
				end
			end
		end
	end,
})

VisualsTab:CreateDropdown({
	Name = "Цвет ESP (ESP Color)",
	Options = {"Red", "Green", "Blue", "Yellow", "Purple", "White"},
	CurrentOption = "Red",
	Flag = "ESPColorDropdown",
	Callback = function(choice)
		for i, data in ipairs(espColors) do
			if data.name == choice then
				currentEspColorIndex = i
				break
			end
		end
		for _, p in ipairs(Players:GetPlayers()) do
			if p.Character and p.Character:FindFirstChild("IY_ESP") then
				p.Character.IY_ESP.FillColor = espColors[currentEspColorIndex].color
			end
		end
	end,
})

