local AdminTab = Window:CreateTab({ ru = "Утилиты", en = "Utilities" }, "rbxassetid://6031080277")

AdminTab.CreateButton({ ru = "Перезайти на сервер (Rejoin)", en = "Rejoin Server" }, function()
	TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
end)

AdminTab.CreateButton({ ru = "Сменить сервер (Server Hop)", en = "Server Hop" }, function()
	local servers = {}
	local success, sitedata = pcall(function()
		return game:GetService("HttpService"):JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"))
	end)
	if success and sitedata and sitedata.data then
		for _, s in ipairs(sitedata.data) do
			if type(s) == "table" and s.playing < s.maxPlayers and s.id ~= game.JobId then
				table.insert(servers, s.id)
			end
		end
		if #servers > 0 then
			TeleportService:TeleportToPlaceInstance(game.PlaceId, servers[math.random(1, #servers)], LocalPlayer)
		else
			Window:Notify({ ru = "Не удалось найти свободный сервер", en = "Could not find an available server" }, 3)
		end
	end
end)

AdminTab.CreateButton({ ru = "Сбросить персонажа (Reset)", en = "Reset Character" }, function()
	local char = LocalPlayer.Character
	if char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.Health = 0
		end
	end
end)
