local bhopConn = nil
local bhopJumpConn = nil
local currentBhopSpeed = 16

FunTab:CreateToggle({
	Name = "Баннихоп (BunnyHop)",
	CurrentValue = false,
	Flag = "Bhop",
	Callback = function(state)
		if state then
			currentBhopSpeed = 16

			bhopJumpConn = UserInputService.JumpRequest:Connect(function()
				local char = LocalPlayer.Character
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				if hum and hum.MoveDirection.Magnitude > 0 then
					currentBhopSpeed = math.clamp(currentBhopSpeed + 4, 16, 55)
				else
					currentBhopSpeed = 16
				end
			end)

			bhopConn = RunService.Heartbeat:Connect(function()
				local char = LocalPlayer.Character
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				local hrp = char and char:FindFirstChild("HumanoidRootPart")
				if not hum or not hrp then return end

				if hum.FloorMaterial == Enum.Material.Air and hum.MoveDirection.Magnitude > 0 then
					local moveDir = hum.MoveDirection.Unit
					local vel = hrp.AssemblyLinearVelocity
					hrp.AssemblyLinearVelocity = Vector3.new(moveDir.X * currentBhopSpeed, vel.Y, moveDir.Z * currentBhopSpeed)
				elseif hum.FloorMaterial ~= Enum.Material.Air and hum.MoveDirection.Magnitude == 0 then
					currentBhopSpeed = 16
				end
			end)
		else
			if bhopConn then bhopConn:Disconnect() bhopConn = nil end
			if bhopJumpConn then bhopJumpConn:Disconnect() bhopJumpConn = nil end
			currentBhopSpeed = 16
		end
	end,
})

