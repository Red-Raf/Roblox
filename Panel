--// Переменные для функций
local flyConn, noclipConn, flingConn, flyFlingConn, infJumpConn, espConn, bhopConn, spinConn
local spinSpeed = 10

local espColors = {
    {name = "Красный", color = Color3.fromRGB(255, 0, 0)},
    {name = "Зеленый", color = Color3.fromRGB(0, 255, 0)},
    {name = "Синий", color = Color3.fromRGB(0, 150, 255)},
    {name = "Желтый", color = Color3.fromRGB(255, 255, 0)},
    {name = "Фиолетовый", color = Color3.fromRGB(150, 0, 255)},
    {name = "Белый", color = Color3.fromRGB(255, 255, 255)}
}
local currentEspColorIndex = 1

--// Безопасный телепорт (анти-кик байпасс)
local function safeTeleportTo(targetPart)
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp or not targetPart then return end
    
    pcall(function()
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        hrp.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
        task.wait(0.05)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end)
end

--====================================================
-- ВКЛАДКА: ГЛАВНАЯ (Fly, Noclip, Fling, Spin)
--====================================================

MainTab.CreateToggle({ ru = "Полёт (Fly)", en = "Fly" }, false, function(state)
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    if state then
        local bv = Instance.new("BodyVelocity")
        bv.Name = "IY_FlyVel"
        bv.Parent = hrp
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Velocity = Vector3.zero

        local bg = Instance.new("BodyGyro")
        bg.Name = "IY_FlyGyro"
        bg.Parent = hrp
        bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bg.P = 1000

        hum.PlatformStand = true

        flyConn = RunService.RenderStepped:Connect(function()
            local cam = workspace.CurrentCamera
            local moveDir = hum.MoveDirection
            bv.Velocity = moveDir * 50
            bg.CFrame = cam.CFrame
        end)
    else
        if flyConn then flyConn:Disconnect() end
        if hum then hum.PlatformStand = false end
        if hrp:FindFirstChild("IY_FlyVel") then hrp.IY_FlyVel:Destroy() end
        if hrp:FindFirstChild("IY_FlyGyro") then hrp.IY_FlyGyro:Destroy() end
    end
end)

MainTab.CreateToggle({ ru = "Хождение сквозь стены (Noclip)", en = "Noclip" }, false, function(state)
    if state then
        noclipConn = RunService.Stepped:Connect(function()
            local char = LocalPlayer.Character
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
    else
        if noclipConn then noclipConn:Disconnect() end
    end
end)

MainTab.CreateToggle({ ru = "Флинг (Fling)", en = "Fling" }, false, function(state)
    if state then
        flingConn = RunService.Heartbeat:Connect(function()
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local vel = hrp.Velocity
                hrp.Velocity = Vector3.new(30000, 30000, 30000)
                RunService.RenderStepped:Wait()
                if hrp then hrp.Velocity = vel end
            end
        end)
    else
        if flingConn then flingConn:Disconnect() end
    end
end)

MainTab.CreateToggle({ ru = "Флинг в полёте (Fly Fling)", en = "Fly Fling" }, false, function(state)
    if state then
        flyFlingConn = RunService.Heartbeat:Connect(function()
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local cam = workspace.CurrentCamera
            if hrp and cam then
                hrp.CFrame = cam.CFrame
                hrp.Velocity = Vector3.new(99999, 99999, 99999)
                hrp.RotVelocity = Vector3.new(99999, 99999, 99999)
            end
        end)
    else
        if flyFlingConn then flyFlingConn:Disconnect() end
    end
end)

MainTab.CreateSlider({ ru = "Скорость вращения (Spin)", en = "Spin Speed" }, 0, 100, 10, function(value)
