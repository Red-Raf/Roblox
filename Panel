-- Добавляем динамические кнопки для каждого игрока
for _, p in ipairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then
        TpTab.CreateButton({ ru = "Телепорт к: " .. p.Name, en = "Teleport to: " .. p.Name }, function()
            if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                safeTeleportTo(p.Character.HumanoidRootPart)
                Window:Notify({ ru = "Успешный телепорт к " .. p.Name, en = "Teleported to " .. p.Name }, 2)
            else
                Window:Notify({ ru = "Игрок недоступен", en = "Player not available" }, 2)
            end
        end)
    end
end

