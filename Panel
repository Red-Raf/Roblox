local bhopConn
FunTab.CreateToggle({ ru = "Баннихоп (BunnyHop)", en = "BunnyHop" }, false, function(state)
	if state then
		local currentSpeed = 16
		local maxBhopSpeed = 45
		local lastVel = Vector3.zero

		bhopConn = RunService.Heartbeat:Connect(function()
			local char = LocalPlayer.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if not hum or not hrp then return end

			local vel = hrp.AssemblyLinearVelocity
			local horizontalVel = Vector3.new(vel.X, 0, vel.Z)

			if lastVel.Magnitude - horizontalVel.Magnitude > 15 then
				currentSpeed = 16
			end
			lastVel = horizontalVel

			if hum.FloorMaterial ~= Enum.Material.Air and hum.MoveDirection.Magnitude > 0 then
				hum:ChangeState(Enum.HumanoidStateType.Jumping)
				currentSpeed = math.clamp(currentSpeed + 2, 16, maxBhopSpeed)
				local moveDir = hum.MoveDirection.Unit
				hrp.AssemblyLinearVelocity = Vector3.new(moveDir.X * currentSpeed, hrp.AssemblyLinearVelocity.Y, moveDir.Z * currentSpeed)
			elseif hum.FloorMaterial == Enum.Material.Air and hum.MoveDirection.Magnitude > 0 then
				local moveDir = hum.MoveDirection.Unit
				hrp.AssemblyLinearVelocity = Vector3.new(moveDir.X * currentSpeed, hrp.AssemblyLinearVelocity.Y, moveDir.Z * currentSpeed)
			else
				currentSpeed = 16
			end
		end)
	else
		if bhopConn then bhopConn:Disconnect() end
	end
end)

