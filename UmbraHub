local function updateChamsESP()
if not Settings.ChamsESP then return end
for _,plr in pairs(Players:GetPlayers()) do
if plr~=LocalPlayer and plr.Character then
local char=plr.Character
local highlight=char:FindFirstChild("ChamsESP")
if not highlight then
highlight=Instance.new("Highlight")
highlight.Name="ChamsESP"
highlight.Parent=char
table.insert(espObjects,highlight)
end
highlight.FillColor=getRoleColor(plr)
highlight.OutlineColor=getRoleColor(plr)
highlight.FillTransparency=Settings.EspFillTransparency/100
highlight.OutlineTransparency=0.25
end
end
end

local function updateGunESP()
