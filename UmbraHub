local function enableXray()
Settings.Xray=true
for _,part in pairs(workspace:GetDescendants()) do
if part:IsA("BasePart") and not part:IsDescendantOf(LocalPlayer.Character) then
if not xrayParts[part] then xrayParts[part]=part.LocalTransparencyModifier end
part.LocalTransparencyModifier=0.65
end
end
end

local function disableXray()
Settings.Xray=false
for part,orig in pairs(xrayParts) do
pcall(function()
if part and part.Parent then part.LocalTransparencyModifier=orig end
end)
end
xrayParts={}
end

