        local sliderFill = Instance.new("Frame")
        sliderFill.Parent = sliderBg
        sliderFill.Size = UDim2.new(0.5, 0, 1, 0)
        sliderFill.BackgroundColor3 = Color3.fromRGB(220, 220, 230)
        sliderFill.BorderSizePixel = 0

        local fillCorner = Instance.new("UICorner")
        fillCorner.Parent = sliderFill
        fillCorner.CornerRadius = UDim.new(1, 0)

        local handle = Instance.new("Frame")
        handle.Parent = sliderBg
        handle.Size = UDim2.new(0, 16, 0, 16)
        handle.Position = UDim2.new(0.5, -8, 0.5, -8)
        handle.BackgroundColor3 = Color3.fromRGB(210, 210, 220)
        handle.BorderSizePixel = 0

        local handleCorner = Instance.new("UICorner")
        handleCorner.Parent = handle
        handleCorner.CornerRadius = UDim.new(1, 0)

        local dragging = false
        local value = Settings[setting] or min

        local function updateSlider(newValue)
            value = math.clamp(newValue, min, max)
            local pct = (value - min) / (max - min)
            sliderFill.Size = UDim2.new(pct, 0, 1, 0)
            handle.Position = UDim2.new(pct, -8, 0.5, -8)
            valueText.Text = tostring(math.floor(value))
            Settings[setting] = value
            if callback then callback(value) end
            saveSettings()
        end

        updateSlider(value)

        sliderBg.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                mainFrame.Draggable = false
                local pos = input.Position.X - sliderBg.AbsolutePosition.X
                local pct = math.clamp(pos / sliderBg.AbsoluteSize.X, 0, 1)
                updateSlider(min + pct * (max - min))
            end
        end)

        handle.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                mainFrame.Draggable = false
            end
        end)

        UserInputService.InputEnded:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
                dragging = false
                mainFrame.Draggable = true
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                local pos = input.Position.X - sliderBg.AbsolutePosition.X
                local pct = math.clamp(pos / sliderBg.AbsoluteSize.X, 0, 1)
                updateSlider(min + pct * (max - min))
            end
        end)

        return {
            updateExternal = function(newValue)
                updateSlider(newValue)
            end
        }
    end

