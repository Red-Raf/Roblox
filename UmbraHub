local function getPlayerRole(plr)
if not plr then return "Innocent" end
local data=roleCache[plr.Name]
if data then return data end
for _,v in pairs(game:GetDescendants()) do
if v.Name=="GetPlayerData" and v:IsA("RemoteFunction") then
local result=pcall(function() return v:InvokeServer() end)
if result and type(result)=="table" then
for name,info in pairs(result) do
if type(info)=="table" and not info.Dead then
roleCache[name]=info.Role or "Innocent"
end
end
end
break
end
end
return roleCache[plr.Name] or "Innocent"
end

local function getRoleColor(plr)
local role=getPlayerRole(plr)
if role=="Murderer" then return Color3.fromHSV(Settings.MurdererHue/360,1,1) end
if role=="Sheriff" or role=="Hero" then return Color3.fromHSV(Settings.SheriffHue/360,1,1) end
return Color3.fromHSV(Settings.InnocentHue/360,1,1)
end

local function getClosestTarget()
local closest,dist=nil,math.huge
local origin=LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
if not origin then return nil end
for _,plr in pairs(Players:GetPlayers()) do
if plr~=LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
local target=plr.Character.HumanoidRootPart
local d=(target.Position-origin.Position).Magnitude
if d<dist then closest,dist=plr,d end
end
end
return closest
end

local function getMurderer()
for _,plr in pairs(Players:GetPlayers()) do
if plr~=LocalPlayer and getPlayerRole(plr)=="Murderer" then return plr end
end
return nil
end

local function getSheriff()
for _,plr in pairs(Players:GetPlayers()) do
if plr~=LocalPlayer then
local role=getPlayerRole(plr)
if role=="Sheriff" or role=="Hero" then return plr end
end
end
return nil
end

local function getGunDrop()
