        local state = Settings[setting] or false

        local function updateState(newState)
            state = newState
            Settings[setting] = state
            if state then
                toggleFrame.BackgroundColor3 = Color3.fromRGB(40, 40, 44)
                toggleCircle.Position = UDim2.new(1, -19, 0, 1)
                toggleCircle.BackgroundColor3 = Color3.fromRGB(220, 220, 230)
            else
                toggleFrame.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
                toggleCircle.Position = UDim2.new(0, 1, 0, 1)
                toggleCircle.BackgroundColor3 = Color3.fromRGB(210, 210, 220)
            end
            if callback then callback(state) end
            saveSettings()
        end

        updateState(state)

        btn.MouseButton1Click:Connect(function()
            updateState(not state)
        end)

        return {
            set = function(newState)
                updateState(newState)
            end
        }
    end

