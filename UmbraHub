local function coinFarmLoop()
while Settings.CoinFarm and task.wait(0.5) do
local char=LocalPlayer.Character
if not char then continue end
local root=char:FindFirstChild("HumanoidRootPart")
local hum=char:FindFirstChildOfClass("Humanoid")
if not root or not hum or hum.Health<=0 then continue end
local lobby=workspace:FindFirstChild("RegularLobby") or workspace:FindFirstChild("Lobby")
if lobby and (root.Position-lobby:GetPivot().Position).Magnitude<=120 then continue end
local coinContainer=nil
for _,obj in pairs(workspace:GetDescendants()) do
if obj.Name=="CoinContainer" then coinContainer=obj break end
end
if not coinContainer then continue end
local coins={}
for _,coin in pairs(coinContainer:GetChildren()) do
if coin.Name=="Coin_Server" and coin:IsA("BasePart") then table.insert(coins,coin) end
end
table.sort(coins,function(a,b)
return (a.Position-root.Position).Magnitude<(b.Position-root.Position).Magnitude
end)
for _,coin in ipairs(coins) do
if not Settings.CoinFarm then break end
if not root or not root.Parent then break end
local speed=Settings.CoinSpeed or 25
local tween=TweenService:Create(root,TweenInfo.new((root.Position-coin.Position).Magnitude/speed,Enum.EasingStyle.Linear),{CFrame=coin.CFrame})
tween:Play()
tween.Completed:Wait()
task.wait(0.1)
end
end
end

local function orbitLoop()
while Settings.OrbitDistance>0 and task.wait() do
if not orbitTarget or not orbitTarget.Character then
orbitTarget=getMurderer()
if not orbitTarget then orbitTarget=getSheriff() end
end
if orbitTarget and orbitTarget.Character then
local root=orbitTarget.Character:FindFirstChild("HumanoidRootPart")
if root then
orbitAngle=orbitAngle+math.rad(Settings.OrbitSpeed)
local char=LocalPlayer.Character
if char then
local charRoot=char:FindFirstChild("HumanoidRootPart")
if charRoot then
charRoot.CFrame=CFrame.new(root.Position)*CFrame.Angles(0,orbitAngle,0)*CFrame.new(0,0,Settings.OrbitDistance)
end
end
end
end
end
end

local function spectatePlayer(plr)
if spectateConnection then spectateConnection:Disconnect() end
if not plr or not plr.Character then
Camera.CameraType=Enum.CameraType.Custom
local char=LocalPlayer.Character
if char then
local hum=char:FindFirstChildOfClass("Humanoid")
if hum then Camera.CameraSubject=hum end
end
spectateTarget=nil
return
end
local hum=plr.Character:FindFirstChildOfClass("Humanoid")
if not hum then return end
Camera.CameraType=Enum.CameraType.Follow
Camera.CameraSubject=hum
spectateTarget=plr
spectateConnection=RunService.RenderStepped:Connect(function()
if not spectateTarget or not spectateTarget.Character then
Camera.CameraType=Enum.CameraType.Custom
local char=LocalPlayer.Character
if char then
local hum2=char:FindFirstChildOfClass("Humanoid")
if hum2 then Camera.CameraSubject=hum2 end
end
spectateTarget=nil
spectateConnection:Disconnect()
return
end
local newHum=spectateTarget.Character:FindFirstChildOfClass("Humanoid")
if newHum then Camera.CameraSubject=newHum end
end)
end

local function teleportToPlayer(plr)
if not plr or not plr.Character then return end
local char=LocalPlayer.Character
if not char then return end
local root=char:FindFirstChild("HumanoidRootPart")
if not root then return end
local targetRoot=plr.Character:FindFirstChild("HumanoidRootPart")
if targetRoot then
root.CFrame=targetRoot.CFrame+Vector3.new(0,3,0)
end
end

local function flingPlayer(plr)
if not plr or not plr.Character then return end
local char=plr.Character
local root=char:FindFirstChild("HumanoidRootPart")
local hum=char:FindFirstChildOfClass("Humanoid")
if not root or not hum then return end
root.Velocity=Vector3.new(90000000,900000000,90000000)
root.RotVelocity=Vector3.new(900000000,900000000,900000000)
hum:SetStateEnabled(Enum.HumanoidStateType.Seated,false)
task.wait(0.1)
local oldPos=root.CFrame
for i=1,10 do
if not root or not root.Parent then break end
root.CFrame=oldPos*CFrame.new(0,math.sin(i*0.5)*2,0)
task.wait(0.05)
end
root.Velocity=Vector3.new(0,0,0)
root.RotVelocity=Vector3.new(0,0,0)
if oldFPDH then workspace.FallenPartsDestroyHeight=oldFPDH end
end

local function loopFlingPlayer(plr)
if not plr or not plr.Character then return end
task.spawn(function()
while Settings.Fly and plr and plr.Character do
flingPlayer(plr)
task.wait(0.2)
end
end)
end

