-- [[ ОБФУСЦИРОВАННЫЕ СТРОКИ ]] --
local function _(s) return s:reverse():gsub("_", ""):gsub("|", "") end
local function __(s) return (s:gsub(".", function(c) return string.char(string.byte(c) - 1) end)) end
local function ___(s) return (s:gsub(".", function(c) return string.char(string.byte(c) + 1) end)) end

-- [[ НАСТРОЙКИ ]] --
local cfg = {
    enabled = false,
    fov = 120,
    hideFov = false,
    smoothness = 0.3,
    maxDist = 200
}

-- [[ ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ]] --
local function isAlive(char)
    if not char then return false end
    local h = char:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end

local function isVisible(from, to, ignore)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {ignore or {}}
    local result = ws:Raycast(from, (to - from).Unit * (to - from).Magnitude, params)
    return not result or result.Instance:IsDescendantOf(ignore) or result.Distance >= (to - from).Magnitude
end

local function getClosestTarget()
    local plrChar = lplr.Character
    if not plrChar then return nil end
    local hrp = plrChar:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local from = hrp.Position
    local best = nil
    local bestDist = math.huge
    
    for _, player in ipairs(p:GetPlayers()) do
        if player ~= lplr then
            local char = player.Character
            if char and isAlive(char) then
                local targetPart = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
                if targetPart then
                    local pos = targetPart.Position
                    local dist = (pos - from).Magnitude
                    if dist <= cfg.maxDist then
                        local screenPos, onScreen = cam:WorldToViewportPoint(pos)
                        if onScreen then
                            local dx = screenPos.X - (cam.ViewportSize.X / 2)
                            local dy = screenPos.Y - (cam.ViewportSize.Y / 2)
                            local distToCenter = math.sqrt(dx*dx + dy*dy)
                            if distToCenter <= cfg.fov and distToCenter < bestDist then
                                if isVisible(from, pos, plrChar) then
                                    best = targetPart
                                    bestDist = distToCenter
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

-- [[ АИМБОТ (ЛЁГКИЙ) ]] --
local function aimbot()
    if not cfg.enabled then return end
    local target = getClosestTarget()
    if target then
        local targetPos = target.Position
        local lookAt = CFrame.new(cam.CFrame.Position, targetPos)
        cam.CFrame = cam.CFrame:Lerp(lookAt, cfg.smoothness)
    end
end

