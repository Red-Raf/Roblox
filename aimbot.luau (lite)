local mt = getrawmetatable and getrawmetatable(game) or getmetatable(game)
if mt then
    local old = mt.__namecall
    mt.__namecall = function(self, ...)
        local args = {...}
        if args[1] == "Raycast" and cfg.enabled then
            return nil
        end
        return old and old(self, ...)
    end
end

